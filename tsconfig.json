{
  // Covers the harness (spec/, scripts/), the server and the code it shares
  // with the client. The server runs as-is under Node's type stripping, so
  // only erasable syntax is allowed (no enums, no parameter properties).
  // The Vue client has its own web/tsconfig.json, checked by vue-tsc.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts", "spec", "scripts", "server", "shared"]
}
